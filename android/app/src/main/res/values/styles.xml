<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Edge-to-edge per the official Capacitor SystemBars plugin (auto-registered
         in @capacitor/core 8.x via Bridge.java) and the AndroidX edge-to-edge
         guidance. Transparent system bars; SystemBars plugin manages icon style
         (light/dark) at runtime via setStyle, so windowLight*Bar items are
         intentionally omitted here. windowFullscreen is intentionally absent:
         deprecated since API 30 and incompatible with edge-to-edge inset
         handling. cutoutMode=shortEdges keeps the canvas painting under display
         notches/punch-holes. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Hand off to the real app theme after the splash animation finishes
             so our cutout mode and transparent bar colors actually apply at
             runtime instead of the Theme.SplashScreen defaults. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Mirror the transparent-bar overrides so the splash frame itself
             renders edge-to-edge (no white/colored bar at launch). The
             splash drawable already paints #00000a, so the system bars
             read as a continuous dark backdrop. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>